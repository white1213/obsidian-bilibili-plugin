{
  "name": "obsidian-bilibili-embed",
  "version": "0.1.0",
  "description": "在 Obsidian 笔记里内嵌播放B站视频：登录后1080p流式播放，支持时间戳联动",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "node esbuild.config.mjs build",
    "typecheck": "tsc --noEmit",
    "test:api": "node esbuild.config.mjs test && node test/build/api-test.mjs",
    "page": "node esbuild.config.mjs page",
    "test:server": "node test/proxy-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
